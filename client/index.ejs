<body class="game-bg" style="color: black;" data-lobby-id="<%= lobbyId || '' %>" data-lang="<%= lang || 'cs' %>">
  <!--jelikož to nahradí libovolný text, tak to zvládne i doplnění / úpravu třídy -->

  <!-- <%- html.lobby || 'smolik' %> -->
  <div style="position: fixed; top: 0px; left:0px; z-index: 10; border: 2px solid black; display: none;" id="log">
    <!-- <canvas id="show-canvas" style="height: 90%; border: 1px solid red;"></canvas> -->
  </div>
  <div id="total-player-count">0</div>

  <!-- Nevím jestli tam chci blejt html z /partials... asi bych se obešel bez toho zas tak složitý to není, hodilo by se to spíš na nějaký git srandy... -->
  <!-- na všechny přepínací obrzaovky bych měl dát třídu game-sceen, bych to mohl jednodušeji přepínat a nechávat pouze jednu aktivní. Případně nějaký atribut -->


  <!--  Hlavní obrazovka -->
  <div id="main-menu" group="scene" name="menu" class="guiDiv">
    <%- html.scene_main %>
  </div>

  <div id="settings-overlay" group="scene" name="settings" class="hidden guiDiv game-bg-overlay">
    <%- html.scene_settings %>
  </div>
  <div id="tutorial-screen" group="scene" name="tutorial" class="hidden guiDiv game-bg-overlay menu-template">
    <h2>Tutorial</h2><p>Template: choose a lobby, select a starting castle, then click your army on the map and choose a reachable hex to move.</p><button onclick="UserEvent('menu')">Back</button>
  </div>
  <div id="info-screen" group="scene" name="info" class="hidden guiDiv game-bg-overlay menu-template">
    <h2>Game info</h2><p>Template: turn-based strategy prototype with castles, armies, resources, POIs and hex movement.</p><button onclick="UserEvent('menu')">Back</button>
  </div>
  <div id="support-screen" group="scene" name="support" class="hidden guiDiv game-bg-overlay menu-template">
    <h2>Support</h2><p>Template: add bug report links, contact info and troubleshooting notes here.</p><button onclick="UserEvent('menu')">Back</button>
  </div>
  <div id="roadmap-screen" group="scene" name="roadmap" class="hidden guiDiv game-bg-overlay menu-template">
    <h2>Roadmap</h2><ul><li>Lobby flow</li><li>Castle economy</li><li>Army movement</li><li>Combat and diplomacy</li></ul><button onclick="UserEvent('menu')">Back</button>
  </div>
  <div id="test-screen" group="scene" name="test" class="hidden guiDiv game-bg-overlay menu-template">
    <h2>Test lab</h2><p>Template: quick links for smoke testing map, castle and army controls.</p><button onclick="UserEvent('btnPlay')">Open lobbies</button><button onclick="UserEvent('menu')">Back</button>
  </div>


  <!-- Výběr lobby -->
  <div id="servers-list" group="scene" name="servers" class="guiDiv hidden game-bg-overlay">
    <%- html.scene_servers %>
  </div>

  <div id="sceen-prepare-game" group="scene" name="lobby" class="hidden"
    style="width: 1600px; height: 1200px; max-width: 100%; max-height: 100%;">
    <%- html.scene_select %>
  </div>

  <div id="sceen-game-area" group="scene" name="ingame" class="hidden" style="width: 100%; height: 100%;">
    <%- html.scene_game %>
  </div>



